#version 450
// The nine passes of upstream's Metal layer-effects kernels, selected by a push constant and run one after another with
// a barrier between them (each reads what the one before wrote). Keep in step with EffectsCPU.cpp, which is the reference.
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Pixels { uint pixels[]; };
layout(std430, binding = 1) writeonly buffer Result { uint result[]; };
layout(std430, binding = 2) buffer Plane0 { float p0[]; };
layout(std430, binding = 3) buffer Plane1 { float p1[]; };
layout(std430, binding = 4) buffer Plane2 { float p2[]; };
layout(std430, binding = 5) buffer Plane3 { float p3[]; };
layout(std430, binding = 6) buffer Plane4 { float p4[]; };
layout(std430, binding = 7) buffer Plane5 { float p5[]; };
layout(std430, binding = 8) buffer Plane6 { float p6[]; };
layout(std430, binding = 9) buffer Plane7 { float p7[]; };
layout(std430, binding = 10) readonly buffer Params {
    // flags: 1 stroke, 2 inside, 4 shadow, 8 overlay, 16 inner, 32 outer glow
    uint width; uint height; uint strokeReach; uint flags;
    float shadowDx; float shadowDy; float shadowSigma; float innerDx;
    float innerDy; float innerSigma; float outerSigma; float pad1;
    vec4 stroke; vec4 shadow; vec4 overlay; vec4 inner; vec4 outer;   // rgb, opacity
};
layout(push_constant) uniform Push { uint pass; } pc;

float rd(uint plane, uint i) {
    switch (plane) {
        case 0: return p0[i]; case 1: return p1[i]; case 2: return p2[i]; case 3: return p3[i];
        case 4: return p4[i]; case 5: return p5[i]; case 6: return p6[i]; default: return p7[i];
    }
}
void wr(uint plane, uint i, float v) {
    switch (plane) {
        case 0: p0[i] = v; break; case 1: p1[i] = v; break; case 2: p2[i] = v; break; case 3: p3[i] = v; break;
        case 4: p4[i] = v; break; case 5: p5[i] = v; break; case 6: p6[i] = v; break; default: p7[i] = v; break;
    }
}

void spread(uint src, uint dst, uint x, uint y, bool rows) {
    int reach = int(strokeReach);
    bool smallest = (flags & 2u) != 0u;
    float best = smallest ? 1.0 : 0.0;
    for (int offset = -reach; offset <= reach; ++offset) {
        int sampleAt = int(rows ? x : y) + offset;
        int limit = int(rows ? width : height);
        float value = (sampleAt < 0 || sampleAt >= limit) ? 0.0
            : rd(src, rows ? y * width + uint(sampleAt) : uint(sampleAt) * width + x);
        best = smallest ? min(best, value) : max(best, value);
    }
    wr(dst, y * width + x, best);
}

void shiftPlane(uint src, uint dst, uint x, uint y, float dx, float dy) {
    float sx = float(x) - dx, sy = float(y) - dy;
    float value = 0.0;
    if (sx >= 0.0 && sy >= 0.0 && sx <= float(width - 1u) && sy <= float(height - 1u)) {
        uint x0 = uint(floor(sx)), y0 = uint(floor(sy));
        uint x1 = min(x0 + 1u, width - 1u), y1 = min(y0 + 1u, height - 1u);
        float fx = sx - float(x0), fy = sy - float(y0);
        float top = mix(rd(src, y0 * width + x0), rd(src, y0 * width + x1), fx);
        float bottom = mix(rd(src, y1 * width + x0), rd(src, y1 * width + x1), fx);
        value = mix(top, bottom, fy);
    }
    wr(dst, y * width + x, value);
}

void blurPlane(uint src, uint dst, uint x, uint y, float sigma, bool rows) {
    int radius = max(1, int(round(sigma * 3.0)));
    float total = 0.0, weightSum = 0.0;
    for (int offset = -radius; offset <= radius; ++offset) {
        float weight = exp(-float(offset * offset) / (2.0 * sigma * sigma));
        int limit = int(rows ? width : height);
        int sampleAt = clamp(int(rows ? x : y) + offset, 0, limit - 1);
        total += weight * rd(src, rows ? y * width + uint(sampleAt) : uint(sampleAt) * width + x);
        weightSum += weight;
    }
    wr(dst, y * width + x, total / weightSum);
}

void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) return;
    uint i = y * width + x;
    switch (pc.pass) {
        case 0u: p0[i] = float((pixels[i] >> 24) & 255u) / 255.0; break;                    // alpha -> shape
        case 1u: spread(0u, 2u, x, y, true); break;                                         // stroke reach, rows
        case 2u: spread(2u, 1u, x, y, false); break;                                        // ... columns
        case 3u: p2[i] = clamp(((flags & 2u) != 0u) ? p0[i] - p1[i] : p1[i] - p0[i], 0.0, 1.0); break; // ring
        case 4u: shiftPlane(0u, 1u, x, y, shadowDx, shadowDy); break;                       // shadow: move
        case 5u: blurPlane(1u, 3u, x, y, shadowSigma, true); break;                         // shadow: blur rows
        case 6u: blurPlane(3u, 1u, x, y, shadowSigma, false); break;                        // ... columns
        case 7u: shiftPlane(0u, 4u, x, y, innerDx, innerDy); break;                         // inner shadow: move
        case 8u: blurPlane(4u, 5u, x, y, innerSigma, true); break;
        case 9u: blurPlane(5u, 4u, x, y, innerSigma, false); break;
        case 10u: p5[i] = clamp(p0[i] * (1.0 - p4[i]), 0.0, 1.0); break;                    // inside
        case 11u: blurPlane(0u, 6u, x, y, outerSigma, true); break;                         // outer glow: blur rows
        case 12u: blurPlane(6u, 7u, x, y, outerSigma, false); break;                        // ... columns
        case 13u: p7[i] = clamp(p7[i] * (1.0 - p0[i]), 0.0, 1.0); break;                    // outer glow: exclude interior
        case 14u: p7[i] = p0[i]; break;                                                     // outer glow: no blur, copy the shape
        default: {                                                                          // compose
            vec3 colour = vec3(0.0);
            float alpha = 0.0;
            if ((flags & 4u) != 0u) {
                float coverage = clamp(p1[i] * shadow.w, 0.0, 1.0);
                colour = shadow.xyz * coverage; alpha = coverage;
            }
            if ((flags & 32u) != 0u) {
                float coverage = clamp(p7[i] * outer.w, 0.0, 1.0);
                colour = outer.xyz * coverage + colour * (1.0 - coverage);
                alpha = coverage + alpha * (1.0 - coverage);
            }
            float strokeCoverage = (flags & 1u) != 0u ? clamp(p2[i] * stroke.w, 0.0, 1.0) : 0.0;
            if ((flags & 1u) != 0u && (flags & 2u) == 0u) {
                colour = stroke.xyz * strokeCoverage + colour * (1.0 - strokeCoverage);
                alpha = strokeCoverage + alpha * (1.0 - strokeCoverage);
            }
            uint packed = pixels[i];
            vec4 source = vec4(float(packed & 255u), float((packed >> 8) & 255u), float((packed >> 16) & 255u), float((packed >> 24) & 255u)) / 255.0;
            colour = source.xyz + colour * (1.0 - source.w);
            alpha = source.w + alpha * (1.0 - source.w);
            if ((flags & 8u) != 0u) {
                float coverage = clamp(p0[i] * overlay.w, 0.0, 1.0);
                colour = overlay.xyz * coverage + colour * (1.0 - coverage);
                alpha = coverage + alpha * (1.0 - coverage);
            }
            if ((flags & 16u) != 0u) {
                float coverage = clamp(p5[i] * inner.w, 0.0, 1.0);
                colour = inner.xyz * coverage + colour * (1.0 - coverage);
                alpha = coverage + alpha * (1.0 - coverage);
            }
            if ((flags & 1u) != 0u && (flags & 2u) != 0u) {
                colour = stroke.xyz * strokeCoverage + colour * (1.0 - strokeCoverage);
                alpha = strokeCoverage + alpha * (1.0 - strokeCoverage);
            }
            uvec4 bytes = uvec4(clamp(vec4(colour, alpha), 0.0, 1.0) * 255.0 + 0.5);
            result[i] = bytes.x | (bytes.y << 8) | (bytes.z << 16) | (bytes.w << 24);
        }
    }
}
